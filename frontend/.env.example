# Copy to frontend/.env.local to change these. Neither is a secret: both end up in the browser.
# scripts/dev.py sets both for you, so you need this file only when you run `npm run dev` by hand.

# Where the backend runs (python scripts/dev.py, or cd backend && uvicorn app.main:app --port 8000).
VITE_API_BASE_URL=http://localhost:8000

# live: the screens call the backend at VITE_API_BASE_URL (what this example sets).
# mock: every screen uses its built-in sample data and nothing is sent anywhere. Without a .env.local, the app
#       starts in mock mode.
VITE_API_MODE=live
