# Copy to frontend/.env.local to change these. Neither is a secret: both end up in the browser.

# Where the backend runs (cd backend && uvicorn app.main:app --port 8000).
VITE_API_BASE_URL=http://localhost:8000

# mock: every screen uses its built-in sample data and nothing is sent anywhere (the default).
# live: the screens call the backend at VITE_API_BASE_URL.
VITE_API_MODE=mock
