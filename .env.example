# Copy to .env in the repository root (there is no backend/.env) and fill in only what your work needs.
# Never commit .env. Where each key comes from, its free limits and its terms: docs/api-setup.md.
# Keys and secrets are empty here; other values are safe defaults.
# Keep each comment on its own line: python-dotenv before 1.2.4, and tools such as Docker's --env-file, read
# "KEY=   # note" as the value "# note", not as empty.

# --- Backend API ----------------------------------------------------------------
# Browser origins allowed to call the API (CORS), comma-separated; never *. Default: the frontend's dev server.
FRONTEND_ORIGINS=http://localhost:3000

# --- LLM providers (all free tiers) -------------------------------------------
# Which provider sees what is decided by the routes table in backend/config/models.yaml (docs/api-setup.md).
# Groq: private, Reddit and public text (does not train on inputs).
GROQ_API_KEY=
# Gemini: public text ONLY (free tier may be used for training).
GEMINI_API_KEY=
# OpenRouter: public text ONLY (training by the :free hosts is not confirmed).
OPENROUTER_API_KEY=
# Cerebras: private, Reddit and public text (does not train on inputs).
CEREBRAS_API_KEY=
# Mistral: public text ONLY (the free plan may train on inputs).
MISTRAL_API_KEY=
# DeepSeek: public text ONLY (may train on inputs; D-63). The public fallback after Gemini and Mistral (US-46).
# Runs only on a granted balance: never add a payment method (D-11). HTTP 402 switches it off for the run.
DEEPSEEK_API_KEY=
# The Mistral model the wrapper calls.
MISTRAL_MODEL=ministral-8b-latest
# Requests per minute; empty keeps models.yaml's value (2, read from Mistral's headers).
MISTRAL_RPM=
# Requests per second, if Mistral ever limits by the second; empty sets none.
MISTRAL_RPS=
# Tokens per minute; empty keeps models.yaml's value (40,000).
MISTRAL_TPM=
# Tokens per UTC day; set to the monthly allowance in Mistral's Admin Panel / 31, less 10%.
MISTRAL_DAILY_TOKENS=1000000
# Tokens per UTC day for each provider; empty keeps models.yaml's value (docs/api-setup.md, "Daily token budgets").
GROQ_DAILY_TOKENS=
GEMINI_DAILY_TOKENS=
OPENROUTER_DAILY_TOKENS=
CEREBRAS_DAILY_TOKENS=
DEEPSEEK_DAILY_TOKENS=

# --- Search, community, video, page reading, models ---------------------------
# Web search; 2,500 free queries in total, so the smoke test uses it only with --include serper.
SERPER_API_KEY=
# Reddit (US-12; docs/api-setup.md "Reddit"). The archives need no key.
# archive | official | off
REDDIT_SOURCE=archive
# The archives to try, in order.
REDDIT_ARCHIVES=arctic_shift,pullpush
# https only.
ARCTIC_SHIFT_BASE_URL=https://arctic-shift.photon-reddit.com
PULLPUSH_BASE_URL=https://api.pullpush.io
# Secret. Make one: python -c "import secrets; print(secrets.token_hex(16))"
REDDIT_USER_SALT=
# Reddit's own API: only with REDDIT_SOURCE=official, once Reddit approves our access request.
# From the "script" app at reddit.com/prefs/apps.
REDDIT_CLIENT_ID=
# Secret.
REDDIT_CLIENT_SECRET=
# Reddit's required format.
REDDIT_USER_AGENT=script:shopsense:0.1 (by /u/<your-reddit-username>)
# off: read and keep nothing in the 24-hour research cache.
RESEARCH_CACHE=on
# off: fetch no review pages; their search results stay as snippets.
RESEARCH_PAGES=on
# Restrict the key to the YouTube Data API v3; titles, descriptions and comments only.
YOUTUBE_API_KEY=
# Optional; raises Jina Reader's free rate limit.
JINA_API_KEY=
# Firecrawl (D-62, US-38): reads the pages Jina can't, and backs up Serper. Free plan: 1,000 credits a month.
# Optional: without it, those pages are skipped and the coverage note says so.
FIRECRAWL_API_KEY=
# Optional; a read-only Hugging Face token, only for gated models or higher download limits.
HF_TOKEN=

# --- Database (Supabase) ------------------------------------------------------
# Optional. Empty = the database is off: everything works and nothing is saved. To turn it on, copy the Session
# pooler string from Supabase > Project > Connect and add ?sslmode=require (docs/database.md). Its format is
#   postgresql://postgres.<project-ref>:<password>@<session-pooler-host>:5432/postgres?sslmode=require
DATABASE_URL=
# Seconds one request save may take before the search carries on without it.
DB_TIMEOUT_SECONDS=2

# --- Search runs with live progress (US-12) ------------------------------------
# Optional. Blank means the default shown.
# Searches that may run at once (default 4); one more is told to try again.
SEARCH_RUN_WORKERS=
# How long a finished run can still be fetched by its ID (default 30, from 1 to 120).
SEARCH_RUN_KEEP_MINUTES=
# The longest a progress stream stays silent before a keep-alive (default 15, at most 15).
SEARCH_RUN_PING_SECONDS=
# Finished runs kept in memory at once; the oldest go first (default 500, 1 to 10000).
SEARCH_RUN_MAX_KEPT=

# --- Not read by any code yet: kept for the stories that will use them -------------
# development | test | production
APP_ENV=development
# DEBUG | INFO | WARNING
LOG_LEVEL=INFO
# Login (Sprint 4).
SUPABASE_URL=
# Login (Sprint 4); the publishable key, safe for the browser.
SUPABASE_ANON_KEY=
# Backend only, never the browser.
SUPABASE_SERVICE_ROLE_KEY=

# The frontend's own variables (VITE_API_BASE_URL, VITE_API_MODE) are in frontend/.env.example.
