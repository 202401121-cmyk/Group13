# Copy to .env in the repository root (there is no backend/.env) and fill in only what your work needs.
# Never commit .env. Where each key comes from, its free limits and its terms: docs/api-setup.md.
# Keys and secrets are empty here; other values are safe defaults.

# --- Backend API ----------------------------------------------------------------
# Browser origins allowed to call the API (CORS), comma-separated; never *. Default: the frontend's dev server.
FRONTEND_ORIGINS=http://localhost:3000

# --- LLM providers (all free tiers) -------------------------------------------
# Which provider sees what is decided by the routes table in backend/config/models.yaml (docs/api-setup.md).
GROQ_API_KEY=                  # private, Reddit and public text (does not train on inputs)
GEMINI_API_KEY=                # public text ONLY (free tier may be used for training)
OPENROUTER_API_KEY=            # public text ONLY (training by the :free hosts is not confirmed)
CEREBRAS_API_KEY=              # private, Reddit and public text (does not train on inputs)
MISTRAL_API_KEY=               # public text ONLY (the free plan may train on inputs)
MISTRAL_MODEL=ministral-8b-latest   # the Mistral model the wrapper calls
MISTRAL_RPS=2                  # requests per second, for the whole app
MISTRAL_TPM=500000             # tokens per minute, for the whole app
MISTRAL_DAILY_TOKENS=1000000   # tokens per UTC day; set to the monthly allowance in Mistral's Admin Panel / 31, less 10%

# --- Search, community, video, page reading, models ---------------------------
SERPER_API_KEY=                # web search; 2,500 free queries in total, so the smoke test uses it only with --include serper
# Reddit (US-12; docs/api-setup.md "Reddit"). The archives need no key.
REDDIT_SOURCE=archive          # archive | official | off
REDDIT_ARCHIVES=arctic_shift,pullpush   # the archives to try, in order
ARCTIC_SHIFT_BASE_URL=https://arctic-shift.photon-reddit.com   # https only
PULLPUSH_BASE_URL=https://api.pullpush.io   # https only
REDDIT_USER_SALT=              # secret; make one: python -c "import secrets; print(secrets.token_hex(16))"
# Reddit's own API: only with REDDIT_SOURCE=official, once Reddit approves our access request.
REDDIT_CLIENT_ID=              # from the "script" app at reddit.com/prefs/apps
REDDIT_CLIENT_SECRET=          # secret
REDDIT_USER_AGENT=script:shopsense:0.1 (by /u/<your-reddit-username>)   # Reddit's required format
RESEARCH_CACHE=on              # off: read and keep nothing in the 24-hour research cache
RESEARCH_PAGES=on              # off: fetch no review pages; their search results stay as snippets
YOUTUBE_API_KEY=               # restrict the key to the YouTube Data API v3; titles, descriptions and comments only
JINA_API_KEY=                  # optional; raises Jina Reader's free rate limit
HF_TOKEN=                      # optional; a read-only Hugging Face token, only for gated models or higher download limits

# --- Database (Supabase) ------------------------------------------------------
# Optional. Empty = the database is off: everything works and nothing is saved. To turn it on, copy the Session
# pooler string from Supabase > Project > Connect and add ?sslmode=require (docs/database.md). Its format is
#   postgresql://postgres.<project-ref>:<password>@<session-pooler-host>:5432/postgres?sslmode=require
DATABASE_URL=
DB_TIMEOUT_SECONDS=2           # seconds one request save may take before the search carries on without it

# --- Search runs with live progress (US-12) ------------------------------------
# Optional. Blank means the default shown.
SEARCH_RUN_WORKERS=            # searches that may run at once (default 4); one more is told to try again
SEARCH_RUN_KEEP_MINUTES=       # how long a finished run can still be fetched by its ID (default 30, from 1 to 120)
SEARCH_RUN_PING_SECONDS=       # the longest a progress stream stays silent before a keep-alive (default 15, at most 15)
SEARCH_RUN_MAX_KEPT=           # finished runs kept in memory at once; the oldest go first (default 500, 1 to 10000)

# --- Not read by any code yet: kept for the stories that will use them -------------
APP_ENV=development            # development | test | production
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING
SUPABASE_URL=                  # login (Sprint 4)
SUPABASE_ANON_KEY=             # login (Sprint 4); the publishable key, safe for the browser
SUPABASE_SERVICE_ROLE_KEY=     # backend only, never the browser

# The frontend's own variables (VITE_API_BASE_URL, VITE_API_MODE) are in frontend/.env.example.
