{
  "additionalProperties": false,
  "description": "The other side of a disputed value (DR-03): what the outvoted sources say, and the claims that say it. 1.8.0",
  "properties": {
    "value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Value"
    },
    "unit": {
      "anyOf": [
        {
          "maxLength": 16,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unit"
    },
    "score": {
      "anyOf": [
        {
          "maximum": 10.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Score"
    },
    "claim_ids": {
      "description": "Among the value's conflicting claims",
      "items": {
        "pattern": "^clm_[a-f0-9]{8,64}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Claim Ids",
      "type": "array"
    }
  },
  "required": [
    "value",
    "unit",
    "score",
    "claim_ids"
  ],
  "title": "AlternativeValue",
  "type": "object"
}
