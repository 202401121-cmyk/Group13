{
  "$defs": {
    "ClaimType": {
      "description": "DR-05: community claims are experience; manufacturer and lab claims are spec.",
      "enum": [
        "spec",
        "experience"
      ],
      "title": "ClaimType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One claim that a value in the result cites, with where it came from.",
  "properties": {
    "claim_id": {
      "pattern": "^clm_[a-f0-9]{8,64}$",
      "title": "Claim Id",
      "type": "string"
    },
    "source_id": {
      "description": "One of the result's sources",
      "pattern": "^src_[a-f0-9]{8,64}$",
      "title": "Source Id",
      "type": "string"
    },
    "quote": {
      "anyOf": [
        {
          "maxLength": 600,
          "minLength": 3,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The claim's exact words. None when not kept: Reddit's words are not saved (D-53)",
      "title": "Quote"
    },
    "value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "What the claim said, as a number or text. A text value from Reddit or a video's comments is saved as the marker (D-53). None for a score, or in a citation from before 1.11.0",
      "title": "Value"
    },
    "unit": {
      "anyOf": [
        {
          "maxLength": 16,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unit"
    },
    "score": {
      "anyOf": [
        {
          "maximum": 10.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The claim's 0 to 10 judgement, when it gave one",
      "title": "Score"
    },
    "polarity": {
      "anyOf": [
        {
          "enum": [
            "positive",
            "negative",
            "neutral"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Polarity"
    },
    "claim_type": {
      "anyOf": [
        {
          "$ref": "#/$defs/ClaimType"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "retrieved_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "When the claim's source was fetched (build rule 4). None before 1.11.0",
      "title": "Retrieved At"
    }
  },
  "required": [
    "claim_id",
    "source_id",
    "quote",
    "value",
    "unit",
    "score",
    "polarity",
    "claim_type",
    "retrieved_at"
  ],
  "title": "Citation",
  "type": "object"
}
