{
  "$defs": {
    "Claim": {
      "additionalProperties": false,
      "description": "One statement about one product, always with its exact quote (build rule 4).",
      "properties": {
        "id": {
          "pattern": "^clm_[a-f0-9]{8,64}$",
          "title": "Id",
          "type": "string"
        },
        "source_id": {
          "pattern": "^src_[a-f0-9]{8,64}$",
          "title": "Source Id",
          "type": "string"
        },
        "source_url": {
          "description": "The page the quote is from (build rule 4)",
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "product_mention": {
          "description": "The product's name as written",
          "maxLength": 150,
          "minLength": 1,
          "title": "Product Mention",
          "type": "string"
        },
        "is_product_type": {
          "default": false,
          "description": "True for things like 'memory foam' that are not buyable products (US-14)",
          "title": "Is Product Type",
          "type": "boolean"
        },
        "criterion_key": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "None = general opinion",
          "title": "Criterion Key"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Text or a number, e.g. 1.4 for kg. Or a score",
          "title": "Value"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 16,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 10.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "0 to 10 judgement for this criterion. Or a value",
          "title": "Score"
        },
        "quote": {
          "description": "Exact words from the source",
          "maxLength": 600,
          "minLength": 3,
          "title": "Quote",
          "type": "string"
        },
        "claim_type": {
          "$ref": "#/$defs/ClaimType"
        },
        "polarity": {
          "enum": [
            "positive",
            "negative",
            "neutral"
          ],
          "title": "Polarity",
          "type": "string"
        },
        "weight": {
          "default": 1.0,
          "description": "Lowered by sarcasm, weak complaints (US-42)",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Weight",
          "type": "number"
        },
        "retrieved_at": {
          "description": "When the source was fetched (build rule 4)",
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "extracted_at": {
          "description": "When this claim was read from the source",
          "format": "date-time",
          "title": "Extracted At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source_id",
        "source_url",
        "product_mention",
        "is_product_type",
        "criterion_key",
        "value",
        "unit",
        "score",
        "quote",
        "claim_type",
        "polarity",
        "weight",
        "retrieved_at",
        "extracted_at"
      ],
      "title": "Claim",
      "type": "object"
    },
    "ClaimType": {
      "description": "DR-05: community claims are experience; manufacturer and lab claims are spec.",
      "enum": [
        "spec",
        "experience"
      ],
      "title": "ClaimType",
      "type": "string"
    },
    "ProductMention": {
      "additionalProperties": false,
      "properties": {
        "raw_name": {
          "maxLength": 150,
          "minLength": 1,
          "title": "Raw Name",
          "type": "string"
        },
        "is_product": {
          "description": "False for product types such as 'memory foam' (US-14)",
          "title": "Is Product",
          "type": "boolean"
        },
        "brand": {
          "anyOf": [
            {
              "maxLength": 60,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Brand"
        },
        "author_hash": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "For distinct-recommender counts. A salted sha256, never a username",
          "title": "Author Hash"
        },
        "recommends": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recommends"
        }
      },
      "required": [
        "raw_name",
        "is_product",
        "brand",
        "author_hash",
        "recommends"
      ],
      "title": "ProductMention",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "source_id": {
      "pattern": "^src_[a-f0-9]{8,64}$",
      "title": "Source Id",
      "type": "string"
    },
    "mentions": {
      "items": {
        "$ref": "#/$defs/ProductMention"
      },
      "maxItems": 100,
      "title": "Mentions",
      "type": "array"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "maxItems": 200,
      "title": "Claims",
      "type": "array"
    }
  },
  "required": [
    "source_id",
    "mentions",
    "claims"
  ],
  "title": "ExtractionResult",
  "type": "object"
}
