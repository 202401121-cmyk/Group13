{
  "$defs": {
    "AlternativeValue": {
      "additionalProperties": false,
      "description": "The other side of a disputed value (DR-03): what the outvoted sources say, and the claims that say it. 1.8.0",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 16,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 10.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "claim_ids": {
          "description": "Among the value's conflicting claims",
          "items": {
            "pattern": "^clm_[a-f0-9]{8,64}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Claim Ids",
          "type": "array"
        }
      },
      "required": [
        "value",
        "unit",
        "score",
        "claim_ids"
      ],
      "title": "AlternativeValue",
      "type": "object"
    },
    "ValueState": {
      "enum": [
        "known",
        "disputed",
        "unknown",
        "estimated"
      ],
      "title": "ValueState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "product_id": {
      "pattern": "^prd_[A-Za-z0-9_-]{3,64}$",
      "title": "Product Id",
      "type": "string"
    },
    "criterion_key": {
      "description": "A criterion key, or a hard-rule attribute such as 'ram_gb'",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
      "title": "Criterion Key",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/ValueState"
    },
    "score": {
      "anyOf": [
        {
          "maximum": 10.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Score"
    },
    "value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Value"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "supporting_claim_ids": {
      "items": {
        "pattern": "^clm_[a-f0-9]{8,64}$",
        "type": "string"
      },
      "title": "Supporting Claim Ids",
      "type": "array"
    },
    "conflicting_claim_ids": {
      "items": {
        "pattern": "^clm_[a-f0-9]{8,64}$",
        "type": "string"
      },
      "title": "Conflicting Claim Ids",
      "type": "array"
    },
    "alternatives": {
      "description": "A disputed value's other side, each with its claims. 1.8.0",
      "items": {
        "$ref": "#/$defs/AlternativeValue"
      },
      "maxItems": 20,
      "title": "Alternatives",
      "type": "array"
    }
  },
  "required": [
    "product_id",
    "criterion_key",
    "state",
    "score",
    "value",
    "confidence",
    "supporting_claim_ids",
    "conflicting_claim_ids",
    "alternatives"
  ],
  "title": "ResolvedValue",
  "type": "object"
}
