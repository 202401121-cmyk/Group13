{
  "$defs": {
    "Source": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^src_[a-f0-9]{8,64}$",
          "title": "Id",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/SourceType"
        },
        "tier": {
          "$ref": "#/$defs/SourceTier"
        },
        "title": {
          "maxLength": 300,
          "title": "Title",
          "type": "string"
        },
        "text": {
          "description": "Cleaned, HTML stripped, capped",
          "maxLength": 12000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "text_hash": {
          "description": "sha256 of text, used for caching",
          "pattern": "^[a-f0-9]{64}$",
          "title": "Text Hash",
          "type": "string"
        },
        "fetched_at": {
          "format": "date-time",
          "title": "Fetched At",
          "type": "string"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "community": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "e.g. 'r/SuggestALaptop'",
          "title": "Community"
        },
        "site": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The site's domain, for a web page",
          "title": "Site"
        },
        "data_class": {
          "default": "public",
          "description": "What this text may be sent to (US-46). Follows the type: Reddit is reddit, the rest public",
          "enum": [
            "public",
            "reddit"
          ],
          "title": "Data Class",
          "type": "string"
        },
        "quality": {
          "default": 0.5,
          "description": "US-13 thread or page quality score",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Quality",
          "type": "number"
        },
        "via": {
          "enum": [
            "api",
            "direct",
            "jina",
            "search_snippet"
          ],
          "title": "Via",
          "type": "string"
        },
        "source_detail": {
          "anyOf": [
            {
              "enum": [
                "arctic_shift",
                "pullpush",
                "official"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reddit only: which archive or API the text came from (US-12)",
          "title": "Source Detail"
        },
        "author_hash": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Salted sha256 of the author's username, so US-13 can count distinct people. Never the name",
          "title": "Author Hash"
        },
        "upvotes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reddit only. Can be negative",
          "title": "Upvotes"
        },
        "comment_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reddit only: the thread's total",
          "title": "Comment Count"
        },
        "comments": {
          "default": [],
          "description": "Reddit only: the comments we read",
          "items": {
            "$ref": "#/$defs/SourceComment"
          },
          "maxItems": 200,
          "title": "Comments",
          "type": "array"
        }
      },
      "required": [
        "id",
        "url",
        "type",
        "tier",
        "title",
        "text",
        "text_hash",
        "fetched_at",
        "published_at",
        "community",
        "site",
        "data_class",
        "quality",
        "via",
        "source_detail",
        "author_hash",
        "upvotes",
        "comment_count",
        "comments"
      ],
      "title": "Source",
      "type": "object"
    },
    "SourceComment": {
      "additionalProperties": false,
      "description": "One Reddit comment in a thread (US-13).",
      "properties": {
        "id": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "parent_id": {
          "anyOf": [
            {
              "maxLength": 32,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The comment or thread it replies to",
          "title": "Parent Id"
        },
        "depth": {
          "description": "1 is a direct reply to the thread",
          "maximum": 3,
          "minimum": 1,
          "title": "Depth",
          "type": "integer"
        },
        "upvotes": {
          "description": "Can be negative",
          "title": "Upvotes",
          "type": "integer"
        },
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "quality": {
          "default": 0.5,
          "description": "US-13 comment quality score",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Quality",
          "type": "number"
        },
        "author_hash": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A salted hash of the author's username, so one person counts once. Never the username itself (D-53). The code that builds a comment makes the hash; this model can't tell a hash from a name. None when the author is deleted or unknown.",
          "title": "Author Hash"
        }
      },
      "required": [
        "id",
        "parent_id",
        "depth",
        "upvotes",
        "text",
        "quality",
        "author_hash"
      ],
      "title": "SourceComment",
      "type": "object"
    },
    "SourceTier": {
      "description": "DR-03: lower number = more authoritative for factual specs.",
      "enum": [
        1,
        2,
        3,
        4,
        5
      ],
      "title": "SourceTier",
      "type": "integer"
    },
    "SourceType": {
      "enum": [
        "reddit",
        "youtube",
        "web_search",
        "review_site",
        "manufacturer",
        "lab",
        "retailer"
      ],
      "title": "SourceType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "source": {
      "$ref": "#/$defs/Source"
    },
    "criterion_keys": {
      "items": {
        "maxLength": 64,
        "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
        "type": "string"
      },
      "maxItems": 10,
      "minItems": 1,
      "title": "Criterion Keys",
      "type": "array"
    },
    "category_label": {
      "maxLength": 60,
      "title": "Category Label",
      "type": "string"
    }
  },
  "required": [
    "source",
    "criterion_keys",
    "category_label"
  ],
  "title": "ExtractInput",
  "type": "object"
}
