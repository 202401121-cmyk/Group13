{
  "$defs": {
    "CheckedValue": {
      "additionalProperties": false,
      "description": "A value the filter read for one product (US-23, P-42): its price, or a hard rule's attribute, as decide used it.\n\nWith these the browser can filter again, for a changed budget or rule, with no server call, keeping a rule as decide\ndoes (docs/frontend-api.md, \"Sprint 5 contracts\"):\n- no values: the filter had nothing to read, so it can't tell;\n- one value: the rule keeps it or not;\n- several, not versions (the sides of a disputed value): every side keeps it, it passes; every side breaks it, it\n  fails; else it can't tell. A disputed value with one side alone can't tell either;\n- versions (any_version): any version keeping the rule is enough. If none does and one can't be compared, it can't\n  tell; if none does and the claims gave a disputed value with one side alone, it can't tell; else it fails.",
      "properties": {
        "product_id": {
          "pattern": "^prd_[A-Za-z0-9_-]{3,64}$",
          "title": "Product Id",
          "type": "string"
        },
        "attribute": {
          "description": "'price_inr', or a hard rule's attribute such as 'ram_gb'",
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
          "title": "Attribute",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/ValueState",
          "description": "The state as the filter read it: unknown when verify gave no value, and known for a value disputed in scores only, which the filter checks as an agreed one"
        },
        "values": {
          "description": "What the filter compared: the price in rupees; a size as a number in `unit`; else the value as its claims gave it. Every side of a disputed value, or every version of a RAM or storage size, claims' first",
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "string"
              }
            ]
          },
          "maxItems": 40,
          "title": "Values",
          "type": "array"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 16,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The numbers' unit: 'INR' for a price, the rule's ('gb'), else None",
          "title": "Unit"
        },
        "any_version": {
          "default": false,
          "description": "True when values are the versions the product comes in (DR-02): any one keeping a rule is enough",
          "title": "Any Version",
          "type": "boolean"
        },
        "from_names": {
          "default": 0,
          "description": "How many of values, the last ones, are versions only the names state; the rest are the claims.",
          "maximum": 40,
          "minimum": 0,
          "title": "From Names",
          "type": "integer"
        }
      },
      "required": [
        "product_id",
        "attribute",
        "state",
        "values",
        "unit",
        "any_version",
        "from_names"
      ],
      "title": "CheckedValue",
      "type": "object"
    },
    "Contribution": {
      "additionalProperties": false,
      "properties": {
        "criterion_key": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
          "title": "Criterion Key",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 10.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Score"
        },
        "normalized_weight": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Normalized Weight",
          "type": "number"
        },
        "contribution": {
          "description": "score x weight, the share of the final score",
          "minimum": 0,
          "title": "Contribution",
          "type": "number"
        },
        "state": {
          "$ref": "#/$defs/ValueState"
        },
        "basis": {
          "anyOf": [
            {
              "enum": [
                "opinion",
                "compared",
                "estimated"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "How the score was made: a source's opinion, a stated value compared with the other shown products' (P-20), or the peers' average (DR-09). Decide leaves it None where it made no score; None on a result from before 1.9.0",
          "title": "Basis"
        }
      },
      "required": [
        "criterion_key",
        "score",
        "normalized_weight",
        "contribution",
        "state",
        "basis"
      ],
      "title": "Contribution",
      "type": "object"
    },
    "FilteredProduct": {
      "additionalProperties": false,
      "properties": {
        "product_id": {
          "pattern": "^prd_[A-Za-z0-9_-]{3,64}$",
          "title": "Product Id",
          "type": "string"
        },
        "group": {
          "enum": [
            "filtered_out",
            "cant_tell"
          ],
          "title": "Group",
          "type": "string"
        },
        "reasons": {
          "description": "e.g. '₹94,990 is above your ₹80,000 budget'",
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Reasons",
          "type": "array"
        },
        "rule_attribute": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Attribute"
        }
      },
      "required": [
        "product_id",
        "group",
        "reasons",
        "rule_attribute"
      ],
      "title": "FilteredProduct",
      "type": "object"
    },
    "RankedProduct": {
      "additionalProperties": false,
      "properties": {
        "product_id": {
          "pattern": "^prd_[A-Za-z0-9_-]{3,64}$",
          "title": "Product Id",
          "type": "string"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "0 to 100. None for every product when none had evidence on any criterion (1.8.0)",
          "title": "Score"
        },
        "contributions": {
          "items": {
            "$ref": "#/$defs/Contribution"
          },
          "minItems": 1,
          "title": "Contributions",
          "type": "array"
        },
        "coverage": {
          "description": "Share of the score backed by real evidence, not estimates",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Coverage",
          "type": "number"
        },
        "chance_first": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "From simulations; None with the plain score",
          "title": "Chance First"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "enum": [
                "best_match",
                "runner_up"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "gap_to_leader": {
          "minimum": 0,
          "title": "Gap To Leader",
          "type": "number"
        },
        "tied_with": {
          "description": "'Too close to call'",
          "items": {
            "pattern": "^prd_[A-Za-z0-9_-]{3,64}$",
            "type": "string"
          },
          "title": "Tied With",
          "type": "array"
        },
        "separating_criterion": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Separating Criterion"
        },
        "rule_notes": {
          "description": "How a RAM or storage must-have passed through one version of the product, such as 'It meets \"at least 8 GB RAM\" in its 8 GB version' (US-09, S4-24). Empty when no version decided a rule; before 1.10.0",
          "items": {
            "maxLength": 400,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 5,
          "title": "Rule Notes",
          "type": "array"
        }
      },
      "required": [
        "product_id",
        "rank",
        "score",
        "contributions",
        "coverage",
        "chance_first",
        "confidence",
        "label",
        "gap_to_leader",
        "tied_with",
        "separating_criterion",
        "rule_notes"
      ],
      "title": "RankedProduct",
      "type": "object"
    },
    "ValueState": {
      "enum": [
        "known",
        "disputed",
        "unknown",
        "estimated"
      ],
      "title": "ValueState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "ranked": {
      "items": {
        "$ref": "#/$defs/RankedProduct"
      },
      "maxItems": 50,
      "title": "Ranked",
      "type": "array"
    },
    "filtered": {
      "items": {
        "$ref": "#/$defs/FilteredProduct"
      },
      "title": "Filtered",
      "type": "array"
    },
    "relaxation_hint": {
      "anyOf": [
        {
          "maxLength": 300,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "When nothing passes: the one rule whose relaxation helps most",
      "title": "Relaxation Hint"
    },
    "method": {
      "enum": [
        "monte_carlo",
        "weighted"
      ],
      "title": "Method",
      "type": "string"
    },
    "checked_values": {
      "description": "For every product decided, shown, can't tell or filtered out: its price and each hard rule's attribute, as the filter read them (US-23, P-42). Empty before 1.10.0",
      "items": {
        "$ref": "#/$defs/CheckedValue"
      },
      "maxItems": 5000,
      "title": "Checked Values",
      "type": "array"
    }
  },
  "required": [
    "ranked",
    "filtered",
    "relaxation_hint",
    "method",
    "checked_values"
  ],
  "title": "DecideResult",
  "type": "object"
}
