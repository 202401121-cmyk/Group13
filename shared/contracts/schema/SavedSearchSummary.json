{
  "additionalProperties": false,
  "description": "One saved search in a signed-in shopper's list: what they asked, when, and the product that came first.",
  "properties": {
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "request_text": {
      "description": "What the shopper typed",
      "maxLength": 500,
      "minLength": 1,
      "title": "Request Text",
      "type": "string"
    },
    "category": {
      "anyOf": [
        {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Category"
    },
    "top_product": {
      "anyOf": [
        {
          "maxLength": 150,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The best match's name; None when nothing ranked",
      "title": "Top Product"
    }
  },
  "required": [
    "id",
    "created_at",
    "request_text",
    "category",
    "top_product"
  ],
  "title": "SavedSearchSummary",
  "type": "object"
}
