{
  "$defs": {
    "ValueState": {
      "enum": [
        "known",
        "disputed",
        "unknown",
        "estimated"
      ],
      "title": "ValueState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "criterion_key": {
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
      "title": "Criterion Key",
      "type": "string"
    },
    "score": {
      "anyOf": [
        {
          "maximum": 10.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Score"
    },
    "normalized_weight": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Normalized Weight",
      "type": "number"
    },
    "contribution": {
      "description": "score x weight, the share of the final score",
      "minimum": 0,
      "title": "Contribution",
      "type": "number"
    },
    "state": {
      "$ref": "#/$defs/ValueState"
    },
    "basis": {
      "anyOf": [
        {
          "enum": [
            "opinion",
            "compared",
            "estimated"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "How the score was made: a source's opinion, a stated value compared with the other shown products' (P-20), or the peers' average (DR-09). Decide leaves it None where it made no score; None on a result from before 1.9.0",
      "title": "Basis"
    }
  },
  "required": [
    "criterion_key",
    "score",
    "normalized_weight",
    "contribution",
    "state",
    "basis"
  ],
  "title": "Contribution",
  "type": "object"
}
