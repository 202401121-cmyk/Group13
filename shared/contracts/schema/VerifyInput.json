{
  "$defs": {
    "Claim": {
      "additionalProperties": false,
      "description": "One statement about one product, always with its exact quote (build rule 4).",
      "properties": {
        "id": {
          "pattern": "^clm_[a-f0-9]{8,64}$",
          "title": "Id",
          "type": "string"
        },
        "source_id": {
          "pattern": "^src_[a-f0-9]{8,64}$",
          "title": "Source Id",
          "type": "string"
        },
        "source_url": {
          "description": "The page the quote is from (build rule 4)",
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "product_mention": {
          "description": "The product's name as written",
          "maxLength": 150,
          "minLength": 1,
          "title": "Product Mention",
          "type": "string"
        },
        "is_product_type": {
          "default": false,
          "description": "True for things like 'memory foam' that are not buyable products (US-14)",
          "title": "Is Product Type",
          "type": "boolean"
        },
        "criterion_key": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "None = general opinion",
          "title": "Criterion Key"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Text or a number, e.g. 1.4 for kg. Or a score",
          "title": "Value"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 16,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 10.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "0 to 10 judgement for this criterion. Or a value",
          "title": "Score"
        },
        "quote": {
          "description": "Exact words from the source",
          "maxLength": 600,
          "minLength": 3,
          "title": "Quote",
          "type": "string"
        },
        "claim_type": {
          "$ref": "#/$defs/ClaimType"
        },
        "polarity": {
          "enum": [
            "positive",
            "negative",
            "neutral"
          ],
          "title": "Polarity",
          "type": "string"
        },
        "weight": {
          "default": 1.0,
          "description": "Lowered by sarcasm, weak complaints (US-42)",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Weight",
          "type": "number"
        },
        "retrieved_at": {
          "description": "When the source was fetched (build rule 4)",
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "extracted_at": {
          "description": "When this claim was read from the source",
          "format": "date-time",
          "title": "Extracted At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source_id",
        "source_url",
        "product_mention",
        "is_product_type",
        "criterion_key",
        "value",
        "unit",
        "score",
        "quote",
        "claim_type",
        "polarity",
        "weight",
        "retrieved_at",
        "extracted_at"
      ],
      "title": "Claim",
      "type": "object"
    },
    "ClaimType": {
      "description": "DR-05: community claims are experience; manufacturer and lab claims are spec.",
      "enum": [
        "spec",
        "experience"
      ],
      "title": "ClaimType",
      "type": "string"
    },
    "MatchResult": {
      "additionalProperties": false,
      "properties": {
        "products": {
          "items": {
            "$ref": "#/$defs/Product"
          },
          "maxItems": 200,
          "title": "Products",
          "type": "array"
        },
        "alias_map": {
          "additionalProperties": {
            "pattern": "^prd_[A-Za-z0-9_-]{3,64}$",
            "type": "string"
          },
          "description": "Every raw name -> its canonical product",
          "title": "Alias Map",
          "type": "object"
        },
        "unmatched": {
          "description": "Names kept apart because matching was unsure",
          "items": {
            "type": "string"
          },
          "title": "Unmatched",
          "type": "array"
        },
        "method": {
          "enum": [
            "model",
            "fuzzy"
          ],
          "title": "Method",
          "type": "string"
        }
      },
      "required": [
        "products",
        "alias_map",
        "unmatched",
        "method"
      ],
      "title": "MatchResult",
      "type": "object"
    },
    "Product": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^prd_[A-Za-z0-9_-]{3,64}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "description": "Canonical display name",
          "maxLength": 150,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "brand": {
          "anyOf": [
            {
              "maxLength": 60,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Brand"
        },
        "kind": {
          "default": "product",
          "description": "product_type for commodities like 'ring-shank nails'",
          "enum": [
            "product",
            "product_type"
          ],
          "title": "Kind",
          "type": "string"
        },
        "aliases": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Aliases",
          "type": "array"
        },
        "variants": {
          "items": {
            "$ref": "#/$defs/Variant"
          },
          "maxItems": 20,
          "title": "Variants",
          "type": "array"
        },
        "recommender_count": {
          "default": 0,
          "description": "Distinct authors who recommended it",
          "minimum": 0,
          "title": "Recommender Count",
          "type": "integer"
        },
        "weighted_mentions": {
          "default": 0.0,
          "description": "Mentions after the 180-day half-life",
          "minimum": 0,
          "title": "Weighted Mentions",
          "type": "number"
        }
      },
      "required": [
        "id",
        "name",
        "brand",
        "kind",
        "aliases",
        "variants",
        "recommender_count",
        "weighted_mentions"
      ],
      "title": "Product",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^src_[a-f0-9]{8,64}$",
          "title": "Id",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/SourceType"
        },
        "tier": {
          "$ref": "#/$defs/SourceTier"
        },
        "title": {
          "maxLength": 300,
          "title": "Title",
          "type": "string"
        },
        "text": {
          "description": "Cleaned, HTML stripped, capped",
          "maxLength": 12000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "text_hash": {
          "description": "sha256 of text, used for caching",
          "pattern": "^[a-f0-9]{64}$",
          "title": "Text Hash",
          "type": "string"
        },
        "fetched_at": {
          "format": "date-time",
          "title": "Fetched At",
          "type": "string"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "community": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "e.g. 'r/SuggestALaptop'",
          "title": "Community"
        },
        "site": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The site's domain, for a web page",
          "title": "Site"
        },
        "data_class": {
          "default": "public",
          "description": "What this text may be sent to (US-46). Follows the type: Reddit is reddit, the rest public",
          "enum": [
            "public",
            "reddit"
          ],
          "title": "Data Class",
          "type": "string"
        },
        "quality": {
          "default": 0.5,
          "description": "US-13 thread or page quality score",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Quality",
          "type": "number"
        },
        "via": {
          "enum": [
            "api",
            "direct",
            "jina",
            "search_snippet"
          ],
          "title": "Via",
          "type": "string"
        },
        "source_detail": {
          "anyOf": [
            {
              "enum": [
                "arctic_shift",
                "pullpush",
                "official"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reddit only: which archive or API the text came from (US-12)",
          "title": "Source Detail"
        },
        "author_hash": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Salted sha256 of the author's username, so US-13 can count distinct people. Never the name",
          "title": "Author Hash"
        },
        "upvotes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reddit only. Can be negative",
          "title": "Upvotes"
        },
        "comment_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reddit only: the thread's total",
          "title": "Comment Count"
        },
        "comments": {
          "default": [],
          "description": "Reddit only: the comments we read",
          "items": {
            "$ref": "#/$defs/SourceComment"
          },
          "maxItems": 200,
          "title": "Comments",
          "type": "array"
        }
      },
      "required": [
        "id",
        "url",
        "type",
        "tier",
        "title",
        "text",
        "text_hash",
        "fetched_at",
        "published_at",
        "community",
        "site",
        "data_class",
        "quality",
        "via",
        "source_detail",
        "author_hash",
        "upvotes",
        "comment_count",
        "comments"
      ],
      "title": "Source",
      "type": "object"
    },
    "SourceComment": {
      "additionalProperties": false,
      "description": "One Reddit comment in a thread (US-13).",
      "properties": {
        "id": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "parent_id": {
          "anyOf": [
            {
              "maxLength": 32,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The comment or thread it replies to",
          "title": "Parent Id"
        },
        "depth": {
          "description": "1 is a direct reply to the thread",
          "maximum": 3,
          "minimum": 1,
          "title": "Depth",
          "type": "integer"
        },
        "upvotes": {
          "description": "Can be negative",
          "title": "Upvotes",
          "type": "integer"
        },
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "quality": {
          "default": 0.5,
          "description": "US-13 comment quality score",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Quality",
          "type": "number"
        },
        "author_hash": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A salted hash of the author's username, so one person counts once. Never the username itself (D-53). The code that builds a comment makes the hash; this model can't tell a hash from a name. None when the author is deleted or unknown.",
          "title": "Author Hash"
        }
      },
      "required": [
        "id",
        "parent_id",
        "depth",
        "upvotes",
        "text",
        "quality",
        "author_hash"
      ],
      "title": "SourceComment",
      "type": "object"
    },
    "SourceTier": {
      "description": "DR-03: lower number = more authoritative for factual specs.",
      "enum": [
        1,
        2,
        3,
        4,
        5
      ],
      "title": "SourceTier",
      "type": "integer"
    },
    "SourceType": {
      "enum": [
        "reddit",
        "youtube",
        "web_search",
        "review_site",
        "manufacturer",
        "lab",
        "retailer"
      ],
      "title": "SourceType",
      "type": "string"
    },
    "Variant": {
      "additionalProperties": false,
      "description": "DR-02: versions that differ in price or specs are separate variants of one product.",
      "properties": {
        "id": {
          "pattern": "^var_[A-Za-z0-9_-]{3,64}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "description": "e.g. '16 GB RAM / 512 GB SSD / India'",
          "maxLength": 120,
          "title": "Label",
          "type": "string"
        },
        "attributes": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "e.g. {'ram': '16GB', 'region': 'IN'}",
          "title": "Attributes",
          "type": "object"
        }
      },
      "required": [
        "id",
        "label",
        "attributes"
      ],
      "title": "Variant",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "match": {
      "$ref": "#/$defs/MatchResult"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "maxItems": 5000,
      "title": "Claims",
      "type": "array"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/Source"
      },
      "maxItems": 60,
      "title": "Sources",
      "type": "array"
    },
    "criterion_keys": {
      "description": "Criteria plus any hard-rule attributes to resolve",
      "items": {
        "maxLength": 64,
        "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
        "type": "string"
      },
      "maxItems": 30,
      "minItems": 1,
      "title": "Criterion Keys",
      "type": "array"
    }
  },
  "required": [
    "match",
    "claims",
    "sources",
    "criterion_keys"
  ],
  "title": "VerifyInput",
  "type": "object"
}
