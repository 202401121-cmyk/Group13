{
  "$defs": {
    "ProductMention": {
      "additionalProperties": false,
      "properties": {
        "raw_name": {
          "maxLength": 150,
          "minLength": 1,
          "title": "Raw Name",
          "type": "string"
        },
        "is_product": {
          "description": "False for product types such as 'memory foam' (US-14)",
          "title": "Is Product",
          "type": "boolean"
        },
        "brand": {
          "anyOf": [
            {
              "maxLength": 60,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Brand"
        },
        "author_hash": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "For distinct-recommender counts. A salted sha256, never a username",
          "title": "Author Hash"
        },
        "recommends": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recommends"
        }
      },
      "required": [
        "raw_name",
        "is_product",
        "brand",
        "author_hash",
        "recommends"
      ],
      "title": "ProductMention",
      "type": "object"
    },
    "RecommenderCount": {
      "additionalProperties": false,
      "description": "How many different people recommend one product (US-13). Counted by code, never by an LLM.",
      "properties": {
        "product_mention": {
          "description": "The product's name as written",
          "maxLength": 150,
          "minLength": 1,
          "title": "Product Mention",
          "type": "string"
        },
        "distinct_recommenders": {
          "description": "One person posting ten times counts once",
          "minimum": 0,
          "title": "Distinct Recommenders",
          "type": "integer"
        },
        "threads": {
          "description": "How many threads those people posted in",
          "minimum": 0,
          "title": "Threads",
          "type": "integer"
        }
      },
      "required": [
        "product_mention",
        "distinct_recommenders",
        "threads"
      ],
      "title": "RecommenderCount",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "mentions": {
      "items": {
        "$ref": "#/$defs/ProductMention"
      },
      "maxItems": 1000,
      "title": "Mentions",
      "type": "array"
    },
    "known_aliases": {
      "additionalProperties": {
        "pattern": "^prd_[A-Za-z0-9_-]{3,64}$",
        "type": "string"
      },
      "description": "Saved aliases from earlier searches (DR-06)",
      "title": "Known Aliases",
      "type": "object"
    },
    "recommender_counts": {
      "description": "From research (US-13), for Product.recommender_count",
      "items": {
        "$ref": "#/$defs/RecommenderCount"
      },
      "maxItems": 200,
      "title": "Recommender Counts",
      "type": "array"
    }
  },
  "required": [
    "mentions",
    "known_aliases",
    "recommender_counts"
  ],
  "title": "MatchInput",
  "type": "object"
}
