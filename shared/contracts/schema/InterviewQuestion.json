{
  "$defs": {
    "TermExplanation": {
      "additionalProperties": false,
      "description": "A word in a question that a shopper may not know, explained in plain words.",
      "properties": {
        "term": {
          "description": "The word or phrase as the question uses it",
          "maxLength": 40,
          "minLength": 1,
          "title": "Term",
          "type": "string"
        },
        "criterion_key": {
          "description": "The criterion the term belongs to",
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
          "title": "Criterion Key",
          "type": "string"
        },
        "explanation": {
          "description": "Plain words, at most 40 words",
          "maxLength": 1000,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        }
      },
      "required": [
        "term",
        "criterion_key",
        "explanation"
      ],
      "title": "TermExplanation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^q_[a-z0-9_]{1,40}$",
      "title": "Id",
      "type": "string"
    },
    "criterion_key": {
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
      "title": "Criterion Key",
      "type": "string"
    },
    "text": {
      "maxLength": 300,
      "minLength": 5,
      "title": "Text",
      "type": "string"
    },
    "quick_replies": {
      "items": {
        "type": "string"
      },
      "maxItems": 6,
      "title": "Quick Replies",
      "type": "array"
    },
    "why_asking": {
      "anyOf": [
        {
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Why Asking"
    },
    "terms": {
      "description": "Words in the question explained, at most 5",
      "items": {
        "$ref": "#/$defs/TermExplanation"
      },
      "maxItems": 5,
      "title": "Terms",
      "type": "array"
    }
  },
  "required": [
    "id",
    "criterion_key",
    "text",
    "quick_replies",
    "why_asking",
    "terms"
  ],
  "title": "InterviewQuestion",
  "type": "object"
}
